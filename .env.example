# Google Analytics 4
GA4_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
GA4_PROPERTY_ID=properties/XXXXXXXXX
GA4_INSTALLER_PAGE_PATH=/find-an-installer

# Google Search Console
GSC_SITE_URL=https://span.io
GSC_BRAND_KEYWORD=span

# Meta Graph API
META_ACCESS_TOKEN=your-long-lived-page-access-token
META_PAGE_ID=your-facebook-page-id
META_IG_ACCOUNT_ID=your-instagram-business-account-id

# YouTube
YOUTUBE_API_KEY=your-youtube-data-api-v3-key
YOUTUBE_CHANNEL_ID=your-youtube-channel-id

# Admin (server-side only — never expose to client)
ADMIN_PASSWORD=your-secure-admin-password

# Vercel Postgres
POSTGRES_URL=postgres://...
